{
  "name": "barcode-gen",
  "version": "1.0.0",
  "private": true,
  "description": "Barcode image generator for Cloudflare Pages, built for use with Excel's IMAGE() function",
  "scripts": {
    "dev": "wrangler pages dev public --compatibility-flag=nodejs_compat",
    "deploy": "wrangler pages deploy public --project-name=barcode-gen --compatibility-flag=nodejs_compat"
  },
  "dependencies": {
    "bwip-js": "^4.11.2"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
